{
    "name": "taha20/license-client",
    "description": "مشتری سبک برای اعتبارسنجی لایسنس نرم‌افزار در پروژه‌های Laravel",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "paragonie/sodium_compat": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Taha20\\LicenseClient\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Taha20\\LicenseClient\\LicenseServiceProvider"
            ],
            "aliases": {
                "License": "Taha20\\LicenseClient\\Facades\\License"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
